---
const pipelineNodes = [
  {
    step: '00',
    tag: 'ATTACKER',
    title: 'Attacker',
    text: 'SSH brute-force hits the monitored host',
    isAttacker: true,
  },
  {
    step: '01',
    title: 'Wazuh Agent',
    text: 'Detects activity on the endpoint in real time',
  },
  {
    step: '02',
    title: 'Wazuh Manager',
    text: 'Collects, correlates, raises a structured alert',
  },
  {
    step: '03',
    title: 'Collector API',
    text: 'Pulls and forwards alerts for ML scoring',
  },
  {
    step: '04',
    title: 'AI Classifier',
    text: 'Normalizes features and scores threat probability',
  },
  {
    step: '05',
    title: 'Core + Postgres',
    text: 'Stores findings, posture data, and history',
  },
  {
    step: '06',
    title: 'Grafana / TG',
    text: 'Dashboards + instant Telegram alerts',
  },
];
---

<section class="w-full max-w-7xl mx-auto px-4 py-16 lg:py-24 relative z-10">
  <!-- Section Header -->
  <div class="text-center max-w-3xl mx-auto mb-16">
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 font-mono text-xs font-semibold tracking-widest uppercase mb-4 glow-border-cyan">
      <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-ping"></span>
      SYSTEM ARCHITECTURE
    </div>
    <h2 class="text-3xl md:text-4xl font-mono font-bold text-white mb-4 leading-tight">
      From Raw Attack to Actionable Report
    </h2>
    <p class="text-slate-300 text-base md:text-lg leading-relaxed">
      Seven stages, one continuous pipeline. Every SSH brute-force, anomaly, or policy violation flows through the same automated path.
    </p>
  </div>

  <!-- Horizontal Timeline (Desktop Viewport: lg:block) -->
  <div class="hidden lg:block relative mb-20 px-2">
    <!-- Continuous Horizontal Connecting Line -->
    <div class="absolute top-[24px] left-12 right-12 h-1 bg-gradient-to-r from-rose-500 via-cyan-500 to-emerald-500 -translate-y-1/2 rounded-full shadow-[0_0_20px_rgba(34,211,238,0.4)]"></div>

    <div class="grid grid-cols-7 gap-3 relative z-10">
      {pipelineNodes.map((node) => (
        <div class="flex flex-col items-center text-center group">
          <!-- Circular Node directly on top of line -->
          <div class="relative mb-5 z-20">
            {node.isAttacker ? (
              <div class="w-12 h-12 rounded-full bg-rose-950 border-2 border-rose-500 flex items-center justify-center text-rose-400 font-mono text-xs font-bold shadow-[0_0_20px_rgba(244,63,94,0.6)] group-hover:scale-110 transition-transform">
                <span class="w-3 h-3 rounded-full bg-rose-500 animate-ping"></span>
              </div>
            ) : (
              <div class="w-12 h-12 rounded-full bg-slate-900 border-2 border-cyan-500/60 group-hover:border-cyan-400 flex items-center justify-center text-cyan-400 font-mono text-xs font-bold shadow-[0_0_15px_rgba(34,211,238,0.2)] group-hover:shadow-[0_0_25px_rgba(34,211,238,0.6)] group-hover:scale-110 transition-all">
                {node.step}
              </div>
            )}
          </div>

          <!-- Content Card Below Node -->
          <div class="glass-panel p-4  border border-slate-800/80 bg-cyber-card/60 backdrop-blur-md w-full min-h-[145px] flex flex-col justify-start group-hover:border-cyan-500/40 transition-colors shadow-lg">
            {node.isAttacker && (
              <span class="inline-block px-2 py-0.5 rounded bg-rose-500/20 text-rose-400 border border-rose-500/40 text-[10px] font-mono font-bold mb-1.5 w-fit mx-auto">
                ATTACKER
              </span>
            )}
            <h3 class={`font-mono text-xs font-bold mb-1.5 ${node.isAttacker ? 'text-rose-400' : 'text-white group-hover:text-cyan-400'} transition-colors`}>
              {node.title}
            </h3>
            <p class="text-slate-400 text-[11px] leading-relaxed font-sans">
              {node.text}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Vertical Timeline (Mobile / Tablet Fallback: lg:hidden) -->
  <div class="block lg:hidden relative mb-14 px-2">
    <!-- Continuous Vertical Connecting Line -->
    <div class="absolute top-5 bottom-5 left-7 w-1 bg-gradient-to-b from-rose-500 via-cyan-500 to-emerald-500 rounded-full"></div>

    <div class="space-y-6 relative z-10">
      {pipelineNodes.map((node) => (
        <div class="flex items-start gap-4 group">
          <!-- Circular Node on Vertical Line -->
          <div class="relative shrink-0 z-20">
            {node.isAttacker ? (
              <div class="w-10 h-10 rounded-full bg-rose-950 border-2 border-rose-500 flex items-center justify-center text-rose-400 font-mono text-xs font-bold shadow-[0_0_15px_rgba(244,63,94,0.6)]">
                <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-ping"></span>
              </div>
            ) : (
              <div class="w-10 h-10 rounded-full bg-slate-900 border-2 border-cyan-500/60 flex items-center justify-center text-cyan-400 font-mono text-xs font-bold shadow-[0_0_15px_rgba(34,211,238,0.3)]">
                {node.step}
              </div>
            )}
          </div>

          <!-- Content Card -->
          <div class="glass-panel p-4  border border-slate-800/80 bg-cyber-card/60 backdrop-blur-md flex-1">
            <div class="flex items-center gap-2 mb-1">
              {node.isAttacker && (
                <span class="px-2 py-0.5 rounded bg-rose-500/20 text-rose-400 border border-rose-500/40 text-[10px] font-mono font-bold">
                  ATTACKER
                </span>
              )}
              <h3 class={`font-mono text-sm font-bold ${node.isAttacker ? 'text-rose-400' : 'text-white'}`}>
                {node.title}
              </h3>
            </div>
            <p class="text-slate-400 text-xs leading-relaxed font-sans">
              {node.text}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Bottom Execution Paths (2 Columns / Cards) -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
    <!-- Card 1: Fast Path -->
    <div class="glass-panel-interactive p-6 md:p-8  border border-emerald-500/30 bg-cyber-card/50 backdrop-blur-xl relative overflow-hidden glow-border-emerald">
      <div class="flex items-center justify-between mb-4">
        <span class="inline-flex items-center gap-2 font-mono text-xs font-bold text-emerald-400 bg-emerald-500/10 px-3 py-1.5  border border-emerald-500/30">
          <span>⚡ FAST PATH</span>
          <span class="text-slate-500">|</span>
          <span>REAL-TIME SCORING</span>
        </span>
        <span class="font-mono text-xs text-emerald-400 font-semibold bg-emerald-950/60 px-2.5 py-1 rounded border border-emerald-500/20">
          &lt; 150ms
        </span>
      </div>

      <p class="text-slate-300 text-sm leading-relaxed font-mono bg-slate-950/80 p-4  border border-slate-800/80 text-emerald-300">
        Alert <span class="text-slate-500">→</span> Normalize <span class="text-slate-500">→</span> Extract f1–f8 <span class="text-slate-500">→</span> ML Model <span class="text-slate-500">→</span> p-score <span class="text-slate-500">→</span> Allow / Alert / Redirect to Honeypot
      </p>
    </div>

    <!-- Card 2: Deep Path -->
    <div class="glass-panel-interactive p-6 md:p-8  border border-amber-500/30 bg-cyber-card/50 backdrop-blur-xl relative overflow-hidden glow-border-amber">
      <div class="flex items-center justify-between mb-4">
        <span class="inline-flex items-center gap-2 font-mono text-xs font-bold text-amber-400 bg-amber-500/10 px-3 py-1.5  border border-amber-500/30">
          <span>🔍 DEEP PATH</span>
          <span class="text-slate-500">|</span>
          <span>LLM INVESTIGATION</span>
        </span>
        <span class="font-mono text-xs text-amber-400 font-semibold bg-amber-950/60 px-2.5 py-1 rounded border border-amber-500/20">
          ASYNC ANALYSIS
        </span>
      </div>

      <p class="text-slate-300 text-sm leading-relaxed font-mono bg-slate-950/80 p-4  border border-slate-800/80 text-amber-300">
        Alert <span class="text-slate-500">→</span> Query Wazuh API <span class="text-slate-500">→</span> Build full timeline <span class="text-slate-500">→</span> LLM drafts findings <span class="text-slate-500">→</span> PDF Report + Telegram to analyst
      </p>
    </div>
  </div>
</section>
