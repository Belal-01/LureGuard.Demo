---
import { MatrixToggle } from "./MatrixToggle";
import { ThemeToggle } from "./ThemeToggle";

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { label: "~/home", href: "/", color: "blue" },
  { label: "man lureguard", href: "/docs", color: "cyan" },
  { label: "top --live", href: "/dashboard", color: "amber" },
  { label: "./attack_sim.sh", href: "/#sandbox", color: "rose" },
];
---

<header
  class="w-full top-0 left-0 right-0 z-50 bg-white/80 dark:bg-black/80 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 transition-colors duration-300"
>
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between"
  >
    <!-- Brand Logo -->
    <div class="flex-1 flex items-center justify-start">
      <a href="/" class="flex items-center gap-1.5 group select-none">
        <div
          class="flex items-center text-slate-900 dark:text-white font-black italic tracking-tighter text-xl sm:text-2xl"
        >
          <span>LURE</span>
          <span class="text-cyan-600 dark:text-cyan-400 flex items-center ml-0.5 glow-text-cyan">
            GUARD
            <span
              class="inline-block w-2.5 h-2.5 ml-1 bg-cyan-500 dark:bg-cyan-400 rounded-sm transform rotate-45 group-hover:scale-110 transition-transform shadow-[0_0_10px_rgba(34,211,238,0.6)]"
            ></span>
          </span>
        </div>
      </a>
    </div>

    <!-- Navigation Links -->
    <nav
      class="hidden md:flex flex-1 items-center justify-center gap-5 lg:gap-8 font-sans"
    >
      {
        navItems.map((item) => {
          const isActive =
            currentPath === item.href ||
            (item.href !== "/" && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`text-xs lg:text-sm font-bold tracking-wider uppercase transition-colors py-1 whitespace-nowrap ${
                isActive
                  ? "text-cyan-600 dark:text-cyan-400 font-extrabold border-b-2 border-cyan-600 dark:border-cyan-400"
                  : "text-slate-600 dark:text-slate-300 hover:text-cyan-600 dark:hover:text-cyan-400"
              }`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Right Actions (Theme Toggle Button) -->
    <div class="flex-1 flex items-center justify-end gap-3">
      <ThemeToggle client:only="react" />
    </div>
  </div>
</header>
