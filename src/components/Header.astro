---
import { MatrixToggle } from "./MatrixToggle";
import { ThemeToggle } from "./ThemeToggle";

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { label: "~/home", href: "/", color: "blue" },
  { label: "man lureguard", href: "/guides/01-overview", color: "cyan" },
];
---

<header
  class="w-full sticky top-0 z-50 bg-white/90 dark:bg-[#141923]/90 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 transition-colors duration-300"
>
  <div
    class="w-full px-3 sm:px-6 lg:px-8 py-2.5 sm:py-3.5 flex items-center justify-between"
  >
    <!-- Brand Logo -->
    <div class="flex items-center justify-start">
      <a href="/" class="flex items-center gap-1.5 sm:gap-2.5 group select-none">
        <img
          src="/images/logo.png"
          alt="LureGuard Logo"
          class="h-5 sm:h-8 w-auto object-contain transition-transform group-hover:scale-105"
        />
        <div
          class="flex items-center text-slate-900 dark:text-white font-black italic tracking-tighter text-base sm:text-2xl"
        >
          <span>LURE</span>
          <span
            class="text-cyan-600 dark:text-cyan-400 flex items-center ml-0.5"
          >
            GUARD
            <span
              class="inline-block w-1.5 h-1.5 sm:w-2.5 sm:h-2.5 ml-0.5 sm:ml-1 bg-cyan-500 dark:bg-cyan-400 rounded-sm transform rotate-45 group-hover:scale-110 transition-transform"
            ></span>
          </span>
        </div>
      </a>
    </div>

    <!-- Right Actions & Navigation Links Aligned Right -->
    <div class="flex items-center justify-end gap-1.5 sm:gap-4">
      <nav class="hidden md:flex items-center gap-6 lg:gap-8 font-sans mr-2">
        {
          navItems.map((item) => {
            const isActive =
              currentPath === item.href ||
              (item.href !== "/" && currentPath.startsWith(item.href));
            return (
              <a
                href={item.href}
                class={`text-xs lg:text-sm font-bold tracking-wider uppercase transition-colors py-1 whitespace-nowrap ${
                  isActive
                    ? "text-cyan-600 dark:text-cyan-400 font-extrabold border-b-2 border-cyan-600 dark:border-cyan-400"
                    : "text-slate-600 dark:text-slate-300 hover:text-cyan-600 dark:hover:text-cyan-400"
                }`}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>

      <ThemeToggle client:only="react" />

      <a
        href="https://github.com/MajdKhalaf12/LureGuard.ai"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-3 py-1.5 font-mono text-xs font-semibold transition-all duration-300 border bg-slate-200/80 dark:bg-slate-900/80 border-slate-300/80 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:text-cyan-600 dark:hover:text-cyan-400 hover:border-cyan-500/50 dark:hover:border-cyan-500/50 cursor-pointer select-none"
        title="View LureGuard on GitHub"
        aria-label="GitHub Repository"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
        <span class="hidden sm:inline">GitHub</span>
      </a>
      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-2 rounded-lg text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60 focus:outline-none transition-colors border border-slate-200 dark:border-slate-800"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
      >
        <svg id="menu-icon-open" class="w-5 h-5 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Collapsed Mobile Navigation Dropdown -->
  <div
    id="mobile-menu"
    class="hidden md:hidden w-full border-t border-slate-200/80 dark:border-slate-800/80 bg-white/95 dark:bg-[#141923]/95 backdrop-blur-md px-4 py-3 space-y-2 transition-all duration-200"
  >
    {
      navItems.map((item) => {
        const isActive =
          currentPath === item.href ||
          (item.href !== "/" && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`block px-3 py-2.5 rounded-lg font-sans text-xs font-bold tracking-wider uppercase transition-colors ${
              isActive
                ? "bg-cyan-50 dark:bg-cyan-950/40 text-cyan-600 dark:text-cyan-400 font-extrabold border-l-4 border-cyan-600 dark:border-cyan-400"
                : "text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 hover:text-cyan-600 dark:hover:text-cyan-400"
            }`}
          >
            {item.label}
          </a>
        );
      })
    }
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (btn && menu && iconOpen && iconClose) {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }
</script>
