---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import HeroSection from "../components/HeroSection.astro";
import { LureGuardDashboardShowcase } from "../components/LureGuardDashboardShowcase";
import ProblemSection from "../components/ProblemSection.astro";
import ArchitectureSection from "../components/ArchitectureSection.astro";
import { WhatLureGuardDoesSection } from "../components/WhatLureGuardDoesSection";
import { WhatIsLureGuardSection } from "../components/WhatIsLureGuardSection";
import { InstallSection } from "../components/InstallSection";
import { FaqSection } from "../components/FaqSection";
import { CtaSection } from "../components/CtaSection";
import { MatrixRain } from "../components/MatrixRain";
import { GlobalAIChatWidget } from "../components/GlobalAIChatWidget";
import { SandboxContainer } from "../components/SandboxContainer";
---

<Layout title="LureGuard.ai — Cyber-Security & Honeypot Monitoring Platform">
  <!-- Matrix Background Canvas -->
  <!-- <MatrixRain client:only="react" opacity={0.12} fps={30} />

   Global AI Chat Widget 
  <GlobalAIChatWidget client:only="react" /> -->

  <div class="relative z-10 min-h-screen flex flex-col justify-between">
    <!-- Reusable Header Component -->
    <Header />

    <!-- Hero Section Component -->
    <main class="flex-1 w-full">
      <HeroSection />

      <!-- Live Interactive Dashboard Showcase Section -->
      <LureGuardDashboardShowcase client:only="react" />

      <!-- What Does LureGuard Do Section (Auto-Rotating Progress Tab Bar) -->
      <WhatLureGuardDoesSection client:only="react" />

      <!-- What is LureGuard.ai? Terminal Section -->
      <WhatIsLureGuardSection client:only="react" />

      <!-- Deploy in Three Commands Section -->
      <InstallSection client:only="react" />

      <!-- Frequently Asked Questions (FAQ / RFQ) Section -->
      <FaqSection client:only="react" />

      <!-- Bottom Call To Action (CTA) Section -->
      <CtaSection client:only="react" />

      <!-- Problem Section -->
      <!-- <ProblemSection /> -->

      <!-- System Architecture Section -->
      <!-- <ArchitectureSection /> -->

      <!-- Sandbox Container Section (Anchored for smooth scrolling) -->
      <!-- <section
        id="sandbox"
        class="max-w-7xl mx-auto px-4 py-8 w-full scroll-mt-20"
      >
        <SandboxContainer client:only="react" />
      </section> -->
    </main>

    <!-- Subtle Footer -->
    <footer
      class="w-full border-t border-slate-800/60 py-4 text-center font-mono text-xs text-slate-500"
    >
      <span
        >LureGuard.ai SOC Platform &copy; 2026 // Autonomous Cyber Honeypot
        Gateway</span
      >
    </footer>
  </div>
</Layout>
