---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ProblemSection from '../components/ProblemSection.astro';
import ArchitectureSection from '../components/ArchitectureSection.astro';
import { MatrixRain } from '../components/MatrixRain';
import { TextScramble } from '../components/TextScramble';
import { LiveTerminalPreview } from '../components/LiveTerminalPreview';
import { GlobalAIChatWidget } from '../components/GlobalAIChatWidget';
---

<Layout title="LureGuard.ai — Cyber-Security & Honeypot Monitoring Platform">
	<!-- Matrix Background Canvas -->
	<MatrixRain client:only="react" opacity={0.12} fps={30} />

	<!-- Global AI Chat Widget -->
	<GlobalAIChatWidget client:only="react" />

	<div class="relative z-10 min-h-screen flex flex-col justify-between">
		<!-- Reusable Header Component -->
		<Header />

		<!-- Hero Section Container (Split-Screen 2 Columns) -->
		<main class="flex-1 max-w-7xl w-full mx-auto px-4 py-12 md:py-16 flex flex-col justify-center">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
				<!-- Left Column: Hero Text & Actions -->
				<div class="lg:col-span-7 glass-panel bg-cyber-card/40 backdrop-blur-xl border border-slate-800/90 p-8 md:p-10 rounded-2xl relative overflow-hidden shadow-[0_0_50px_rgba(8,11,16,0.8)] glow-border-emerald text-left">
					<!-- Terminal Scanlines effect inside Hero -->
					<div class="absolute inset-0 scanline-bg opacity-30 pointer-events-none"></div>

					<!-- Terminal Command Header -->
					<div class="flex flex-wrap items-center justify-between gap-3 font-mono text-xs text-slate-400 mb-6 bg-slate-950/70 px-4 py-2 rounded-lg border border-slate-800/80 w-full">
						<div class="flex items-center gap-2">
							<span class="text-emerald-400 font-bold">$</span>
							<span class="text-slate-200">lureguard --status</span>
						</div>
						<div class="flex items-center gap-2">
							<span class="relative flex h-2 w-2">
								<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
								<span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
							</span>
							<span class="text-emerald-400 font-semibold text-[11px] tracking-wide">GATEWAY_ONLINE // HONEYPOT_ACTIVE</span>
						</div>
					</div>

					<!-- Scramble / Decrypt Main Title -->
					<div class="mb-6">
						<span class="text-xs font-mono text-cyan-400 tracking-wider uppercase mb-2 block">
							[CYBER THREAT DEFENSE GATEWAY]
						</span>
						<h1 class="text-3xl md:text-5xl font-mono font-bold text-white leading-tight min-h-[110px] md:min-h-[130px] flex items-center">
							<TextScramble 
								client:only="react" 
								text="Autonomous Cyber Honeypot & Threat Intelligence Gateway" 
								className="glow-text-emerald text-emerald-400"
								scrambleSpeed={25}
							/>
						</h1>
					</div>

					<!-- Brief Description -->
					<p class="text-slate-300 text-base md:text-lg mb-8 leading-relaxed font-sans">
						An advanced defense gateway leveraging interactive <span class="font-mono text-cyan-400">Honeypots</span> and real-time AI threat analysis to safeguard infrastructure, lure adversaries, and identify breach vectors early.
					</p>

					<!-- Quick Action CTAs -->
					<div class="flex flex-wrap items-center gap-4 pt-2 border-t border-slate-800/60">
						<!-- Primary Neon Green Button -->
						<a
							href="/sandbox"
							class="px-6 py-3.5 rounded-lg font-mono text-sm font-bold bg-emerald-500 text-cyber-dark hover:bg-emerald-400 transition-all duration-300 shadow-[0_0_25px_rgba(52,211,153,0.4)] hover:shadow-[0_0_35px_rgba(52,211,153,0.6)] flex items-center gap-2 group transform hover:-translate-y-0.5"
						>
							<span>Launch Sandbox 🔥</span>
							<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="5" y1="12" x2="19" y2="12"></line>
								<polyline points="12 5 19 12 12 19"></polyline>
							</svg>
						</a>

						<!-- Secondary Glass Button -->
						<a
							href="/docs"
							class="px-6 py-3.5 rounded-lg font-mono text-sm font-semibold bg-slate-900/60 text-slate-200 hover:text-white border border-slate-700/80 hover:border-slate-500 hover:bg-slate-800/60 transition-all duration-300 backdrop-blur-md flex items-center gap-2"
						>
							<span>Read Docs</span>
							<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
								<polyline points="14 2 14 8 20 8"></polyline>
								<line x1="16" y1="13" x2="8" y2="13"></line>
								<line x1="16" y1="17" x2="8" y2="17"></line>
								<polyline points="10 9 9 9 8 9"></polyline>
							</svg>
						</a>
					</div>
				</div>

				<!-- Right Column: Live Terminal Preview Box -->
				<div class="lg:col-span-5 w-full flex justify-center">
					<LiveTerminalPreview client:only="react" />
				</div>
			</div>
		</main>

		<!-- Problem Section -->
		<ProblemSection />

		<!-- System Architecture Section -->
		<ArchitectureSection />

		<!-- Subtle Footer -->
		<footer class="w-full border-t border-slate-800/60 py-4 text-center font-mono text-xs text-slate-500">
			<span>LureGuard.ai SOC Platform &copy; 2026 // Autonomous Cyber Honeypot Gateway</span>
		</footer>
	</div>
</Layout>
