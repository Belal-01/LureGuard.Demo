---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { Docs } from '../components/Docs';
import { GlobalAIChatWidget } from '../components/GlobalAIChatWidget';
---

<Layout title="LureGuard Documentation — Technical Manual & Architecture">
	<!-- Global AI Chat Widget -->
	<GlobalAIChatWidget client:only="react" />

	<div class="relative z-10 min-h-screen flex flex-col justify-between">
		<!-- Reusable Header Component -->
		<Header currentPath="/docs" />

		<!-- Main Docs Section -->
		<main class="flex-1 w-full">
			<Docs client:only="react" />
		</main>

		<!-- Footer -->
		<footer class="w-full border-t border-slate-800/60 py-4 text-center font-mono text-xs text-slate-500">
			<span>LureGuard.ai SOC Manual &copy; 2026 // man lureguard(8) Technical Documentation</span>
		</footer>
	</div>
</Layout>
