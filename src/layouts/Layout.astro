---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "LureGuard.ai — Cyber-Security & Honeypot Monitoring Platform",
	description = "Autonomous AI Honeypot & Threat Intelligence SOC Gateway Platform" 
} = Astro.props;
---

<!doctype html>
<html lang="en" dir="ltr" class="dark scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
	</head>
	<body class="bg-cyber-dark text-slate-200 font-sans antialiased selection:bg-neon-emerald selection:text-cyber-dark min-h-screen relative overflow-x-hidden">
		<slot />
	</body>
</html>
